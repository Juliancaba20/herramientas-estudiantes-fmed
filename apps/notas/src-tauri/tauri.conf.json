{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anotomia",
  "version": "0.1.0",
  "identifier": "io.github.juliancaba20.anotomia",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anotomía",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "App de notas para estudiantes",
    "longDescription": "Anotomía: pizarrón infinito, páginas A4 y tarjetas, a mano o con teclado. Sus notas se guardan como archivos en su equipo.",
    "fileAssociations": [
      {
        "ext": ["nota"],
        "name": "Documento de Anotomía",
        "description": "Documento de Anotomía",
        "role": "Editor",
        "mimeType": "application/x-anotomia-nota"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNzYwRjQ2M0JGQzE1MUEKUldRYUZmdzdSZzkyRVZMU25tYkFPRFdIME5xOFVHaThDN1pKcWpqcFkvSDh0ak5ablVQd0xwTksK",
      "endpoints": [
        "https://github.com/Juliancaba20/hipocampus/releases/download/notas-ultima/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "identifier": "principal",
  "description": "Computadoras: abrir y guardar los archivos que la persona elige, buscar actualizaciones y reiniciar al instalarlas",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "updater:default",
    "process:allow-restart"
  ]
}

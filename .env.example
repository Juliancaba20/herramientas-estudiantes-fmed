# Copie este archivo como .env.local para probar en su computadora.
# En Vercel se cargan en Settings > Environment Variables (no se suben a GitHub).

# Clave de la API de Resend (https://resend.com > API Keys)
RESEND_API_KEY=

# Correo donde quiere recibir los mensajes del formulario /contacto
CONTACT_TO=

# Opcional. Si no se define, se usa el remitente de pruebas de Resend (onboarding@resend.dev)
# CONTACT_FROM=Hipocampus <contacto@su-dominio.com>

# ---- Historias diarias de Instagram (ver README, sección «Historias de Instagram») ----
# Clave que protege la tarea programada. Invente una larga y aleatoria; Vercel la envía sola al ejecutarla.
CRON_SECRET=
# Token de acceso de larga duración de la API de Instagram (con inicio de sesión de Instagram)
INSTAGRAM_ACCESS_TOKEN=
# Opcional: identificador numérico de la cuenta profesional (si no se define, se usa «me»)
# INSTAGRAM_USER_ID=
# Opcional pero recomendado: base de datos Redis (Upstash, desde Vercel Marketplace) para
# renovar el token solo cada 30 días y no publicar dos veces el mismo día.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

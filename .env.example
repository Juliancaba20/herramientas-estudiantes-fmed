# Copie este archivo como .env.local para probar en su computadora.
# En Vercel se cargan en Settings > Environment Variables (no se suben a GitHub).

# Clave de la API de Resend (https://resend.com > API Keys)
RESEND_API_KEY=

# Correo donde quiere recibir los mensajes del formulario /contacto
CONTACT_TO=

# Opcional. Si no se define, se usa el remitente de pruebas de Resend (onboarding@resend.dev)
# CONTACT_FROM=Herramientas para estudiantes <contacto@su-dominio.com>
